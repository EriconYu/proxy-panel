# Copy this file to env.conf and edit it before installation.
# env.conf is ignored by Git because it contains deployment-specific values.

DOMAIN=proxy.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=111111

# certbot: request and renew a Let's Encrypt certificate.
# existing: use the two absolute paths below without modifying the certificate.
TLS_MODE=certbot
LETSENCRYPT_EMAIL=admin@example.com
TLS_CERT_PATH=
TLS_KEY_PATH=

# Local-only ports. Only TCP 80 and 443 need to be public.
PANEL_PORT=18080
XRAY_API_PORT=10085
DEVICE_PORT_MIN=11000
DEVICE_PORT_MAX=11999

# Set to false only when DNS has deliberately not propagated yet.
CHECK_DNS=true

XRAY_VERSION=v26.3.27
XRAY_SHA256_AMD64=23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae
XRAY_SHA256_ARM64=4d30283ae614e3057f730f67cd088a42be6fdf91f8639d82cb69e48cde80413c
